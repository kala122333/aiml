# PR9: Clustering Techniques
# K-Means and Hierarchical Clustering using Iris Dataset

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, AgglomerativeClustering
from scipy.cluster.hierarchy import dendrogram, linkage

# 1. Load the predefined Iris dataset
iris = load_iris()
df = pd.DataFrame(iris.data, columns=iris.feature_names)

print("First five rows of the dataset:")
print(df.head())

print("\nDataset shape:", df.shape)

# 2. Standardize the features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df)

# 3. Elbow Method to find optimal K
wcss = []
for k in range(1, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    wcss.append(model.inertia_)

plt.figure(figsize=(7, 4))
plt.plot(range(1, 11), wcss, marker='o')
plt.xlabel("Number of Clusters (K)")
plt.ylabel("WCSS")
plt.title("Elbow Method")
plt.xticks(range(1, 11))
plt.grid(True)
plt.show()

# 4. Apply K-Means Clustering
# K=3 is selected for this demonstration
kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
df["KMeans_Cluster"] = kmeans.fit_predict(X_scaled)

# 5. Plot K-Means clusters using two features
plt.figure(figsize=(7, 4))
plt.scatter(
    X_scaled[:, 2], X_scaled[:, 3],
    c=df["KMeans_Cluster"], cmap="viridis", s=40
)
plt.xlabel("Petal Length (standardized)")
plt.ylabel("Petal Width (standardized)")
plt.title("K-Means Clustering")
plt.show()

# 6. Generate Dendrogram for Hierarchical Clustering
Z = linkage(X_scaled, method="ward")
plt.figure(figsize=(10, 5))
dendrogram(Z, truncate_mode="lastp", p=30)
plt.title("Hierarchical Clustering Dendrogram")
plt.xlabel("Data Points / Clusters")
plt.ylabel("Ward Distance")
plt.show()

# 7. Apply Hierarchical Clustering
hc = AgglomerativeClustering(n_clusters=3, linkage="ward")
df["Hierarchical_Cluster"] = hc.fit_predict(X_scaled)

# 8. Analyze generated clusters
print("\nK-Means Cluster Sizes:")
print(df["KMeans_Cluster"].value_counts().sort_index())

print("\nHierarchical Cluster Sizes:")
print(df["Hierarchical_Cluster"].value_counts().sort_index())

print("\nMean feature values for K-Means clusters:")
print(df.groupby("KMeans_Cluster")[iris.feature_names].mean().round(2))

print("\nMean feature values for Hierarchical clusters:")
print(df.groupby("Hierarchical_Cluster")[iris.feature_names].mean().round(2))

print("\nFirst 10 cluster assignments:")
print(df[["KMeans_Cluster", "Hierarchical_Cluster"]].head(10))
